DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airdrop_hunter
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
ETHERSCAN_API_KEY=replace-with-server-side-etherscan-api-key

# Optional RSS/Atom discovery feeds; semicolon-separated name=https://host/path.xml
AIRDROP_RSS_FEEDS=
# Exact HTTPS hostnames allowed to serve the configured feeds; comma-separated
AIRDROP_RSS_ALLOWED_HOSTS=
# Exact feed source names approved for public content reuse after written permission
# or a license explicitly permits redistribution/public display; comma-separated
# Empty by default: a public RSS URL alone is not reuse permission.
AIRDROP_RSS_APPROVED_SOURCES=
# The web3-discover Vercel API stays disabled unless its public-app reuse is approved.
AIRDROP_HUB_SOURCE_APPROVED=false
# GitHub repository variable controlling the scheduled discovery sync workflow
AIRDROP_DISCOVERY_SYNC_ENABLED=false
