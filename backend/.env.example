DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airdrop_hunter
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
ETHERSCAN_API_KEY=replace-with-server-side-etherscan-api-key

# Optional RSS/Atom discovery feeds; semicolon-separated name=https://host/path.xml
AIRDROP_RSS_FEEDS=
# Exact HTTPS hostnames allowed to serve the configured feeds; comma-separated
AIRDROP_RSS_ALLOWED_HOSTS=
