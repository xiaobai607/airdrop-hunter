# Required backend runtime configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airdrop_hunter
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080

# Optional market enrichment; server-side only
ETHERSCAN_API_KEY=

# Approved zero-cost discovery sources
# CoinGecko Demo API. Leave empty to disable CoinGecko discovery.
COINGECKO_DEMO_API_KEY=

# Optional comma-separated DexScreener search terms (maximum 8).
# Results are market leads only and must never be treated as proof of an airdrop.
DEXSCREENER_SEARCH_QUERIES=SOL,ETH,USDC

# Optional manually reviewed GitHub Raw source approvals.
# Every entry must include source_id, url (HTTPS Raw URL pinned to a full 40-char commit SHA),
# repository, license_id, license_url, attribution, review_status="approved", and reviewed_at.
# A public URL alone is not permission to reuse a repository's content.
AIRDROP_GITHUB_RAW_SOURCE_APPROVALS=[]

# Scheduled discovery stays disabled until source rights, zero-cost hosting,
# database limits, and end-to-end real-data rendering have been verified.
AIRDROP_DISCOVERY_SYNC_ENABLED=false
